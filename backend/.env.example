# --- AI provider selection ---
# Recommended for the hackathon: Gemini's free tier (no card, no expiry).
# Get a key at https://aistudio.google.com  (Google account only)
TAXLENS_USE_GEMINI=true
TAXLENS_GEMINI_API_KEY=your_gemini_api_key_here
TAXLENS_GEMINI_MODEL=gemini-2.5-flash

# Optional alternative: OpenAI (requires billing on your account)
TAXLENS_USE_OPENAI=false
TAXLENS_OPENAI_API_KEY=
TAXLENS_OPENAI_MODEL=gpt-4o-mini

# If both are false (or a call fails), TaxLens uses its deterministic
# fallback provider — the same one the demo and test suite always use.
TAXLENS_AI_CONFIDENCE_THRESHOLD=0.55
TAXLENS_LOG_LEVEL=INFO
TAXLENS_STORE_BACKEND=memory
TAXLENS_DATABASE_URL=postgresql+psycopg://taxlens:taxlens@db:5432/taxlens